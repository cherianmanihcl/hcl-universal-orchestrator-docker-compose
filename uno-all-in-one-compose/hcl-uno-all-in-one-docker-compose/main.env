# ==============================================================================
# HCL UNIVERSAL ORCHESTRATOR - CENTRALIZED CONFIGURATION (.env)
# ==============================================================================

# --- REGISTRY & VERSIONING ---
# The name of the UNO image registry.
UNO_REGISTRY=hclcr.io/uno-ea
# The tag of the UNO image. The default value is latest.
UNO_VERSION=2.1.7.0-beta1
# License indicates whether you accept the license. Supported values are accept and not accepted. Mandatory parameter.
LICENSE=
# --- SYSTEM NETWORKING ---
# Replace 'localhost' with your VM IP if deploying on a remote machine.
UNO_HOST_IP=localhost
# The port on which the authentication API is exposed externally.
UNO_AUTH_API_PORT=8442
# The external URL of the nginx reverse proxy.
UNO_EXTERNAL_NGINX_URL=http://hcl-uno-externalpod:8080
# The base URL from which agent packages and plugins are downloaded.
PACKAGES_URL=http://hcl-uno-externalpod:8080/

# --- INFRASTRUCTURE CONNECTIVITY ---
# These point to the services defined in uno-compose-prerequisites.yml.
# The base URL of the OpenID Connect (OIDC) server.
QUARKUS_OIDC_AUTH_SERVER_URL=
# The URL of the database. Mandatory parameter.
QUARKUS_MONGO_URL=
# The URL of the event streaming platform. Mandatory parameter.
KAFKA_SERVERS=

# --- COMMON SECRETS ---
# Used for Keycloak, MongoDB and PGVector.
# The name of the admin user.
OIDC_USER=
# The client-id of the application in the OpenID Connect (OIDC) server.
QUARKUS_OIDC_CLIENT_ID=
# The client secret used for client_secret_basic authentication with the OIDC server.
QUARKUS_OIDC_CREDENTIALS_SECRET=
# This enables the encryption of tokens before they are stored in cookies.
QUARKUS_OIDC_TOKEN_STATE_MANAGER_ENCRYPTION_REQUIRED=true
# This minimizes session cookie size by splitting OIDC tokens across multiple cookies.
QUARKUS_OIDC_TOKEN_STATE_MANAGER_SPLIT_TOKENS=true
# This enables certificate validation and hostname verification for the OIDC connection.
# Supported values: none (all certs trusted), required (full validation), certificate-validation (cert only).
QUARKUS_OIDC_TLS_VERIFICATION=none
# Enables OIDC-based tenant authentication. Supported values are true and false.
QUARKUS_OIDC_TENANT_ENABLED=true
# Keycloak bootstrap admin username. Used only on first startup to initialize the Keycloak realm.
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=
# Keycloak bootstrap admin password. Used only on first startup to initialize the Keycloak realm.
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=
# The name of the database user. Mandatory parameter.
MONGO_USER=
# The password of the database user. Mandatory parameter.
MONGO_PASSWORD=
# The type of the database. Supported value is mongodb.
DATABASE_TYPE=
# PostgreSQL administrator user for AI Pilot and RAG services.
POSTGRES_USER=
# PostgreSQL administrator password for AI Pilot and RAG services.
POSTGRES_PASSWORD=
# The password for the Valkey (Redis-compatible) service used by Agentic AI Builder.
VALKEY_PASSWORD=

# --- EMAIL CONFIGURATION ---
# This enables or disables the email notification feature. Supported values are true and false.
UNO_MAIL_ENABLED=false
# The SMTP host to send emails.
UNO_MAIL_SMTP_HOST=
# The SMTP port to send emails.
UNO_MAIL_SMTP_PORT=587
# This specifies whether STARTTLS is enabled for the SMTP connection.
UNO_MAIL_SMTP_STARTTLS_ENABLED=true
# The email address from which the emails are sent. Mandatory if mail is enabled.
# Optionally specify the sender name as: "Sender Name <from@mail.com>".
UNO_MAIL_FROM=
# SMTP credentials username.
UNO_MAIL_USERNAME=
# SMTP credentials password.
UNO_MAIL_PASSWORD=
# This specifies whether the SMTP server identity is checked.
UNO_MAIL_SMTP_SSL_CHECKSERVERIDENTITY=true
# This specifies which SMTP servers are trusted (e.g., host.trusted.com).
UNO_MAIL_SMTP_SSL_TRUST=
# The timeout in milliseconds for connecting to the SMTP server.
UNO_MAIL_SMTP_CONNECTION_TIMEOUT=30000

# --- AI PILOT & GENAI ---
# The URL of the GenAI service.
UNO_GENAI_CLIENT_URL=https://genai.services.hcluno.cloud
# This enables the AI Agent and AI Pilot generative AI features. Supported values are true and false.
# By enabling this feature, you agree that AI Agent and AI Pilot prompts will be sent to HCL Software.
UNO_GENAI_CLIENT_ENABLED=false
# The custom key to access the GenAI service provided by HCL Software for beta testing.
UNO_GENAI_LICENSE_CUSTOM_KEY=
# The hostname of the proxy server for GenAI service access.
UNO_GENAI_CLIENT_PROXY_HOSTNAME=
# The port of the proxy server for GenAI service access.
UNO_GENAI_CLIENT_PROXY_PORT=
# The username to authenticate to the proxy server.
UNO_GENAI_CLIENT_PROXY_USERNAME=
# The password to authenticate to the proxy server.
UNO_GENAI_CLIENT_PROXY_PASSWORD=
# The base URL of the AI Pilot core service.
UNO_AI_PILOT_CLIENT_URL=https://hcl-uno-pilot-core:5005
# The WebSocket URL for AI Pilot notifications pushed to the console.
UNO_AI_PILOT_NOTIFICATION_URL=wss://hcl-uno-console-aio:8443
# The JWT issuer URL for the AI Pilot service, used to validate AI Pilot-issued tokens.
UNO_AIPILOT_JWT_ISSUERS=https://hcl-uno-pilot-core:5005
# The location of the AI Pilot public key used to verify JWT tokens.
EXTERNAL_MP_JWT__HTTPS___PILOT_CORE_5005__VERIFY_PUBLICKEY_LOCATION=https://hcl-uno-pilot-core:5005/jwks
# The PostgreSQL user for the AI Pilot core service.
UNO_AI_PILOT_CORE_POSTGRES_USER=pilot
# The PostgreSQL database name used by the AI Pilot core service.
UNO_AI_PILOT_CORE_POSTGRES_DB=rasa
# AI Pilot PostgreSQL user
UNO_PILOT_PGUSER=pilot
# AI Pilot PostgreSQL database name
UNO_PILOT_DB=rasa
# The PostgreSQL user for the RAG (Retrieval-Augmented Generation) service.
UNO_RAG_PGUSER=rag_user
# The PostgreSQL database name for the RAG service.
UNO_RAG_DB=vector_db

# The base URL of the Agentic AI Agent Management Service (AMS).
UNO_AGENTIC_AI_AMS_SERVICE_URL=https://hcl-uno-agentic-ams:8080
# The base URL of the Agentic AI production runner service.
UNO_AGENTIC_AI_RUNNER_PROD_SERVICE_URL=https://hcl-uno-agentic-runner-prod:8080
# The base URL of the Agentic AI test runner service.
UNO_AGENTIC_AI_RUNNER_TEST_SERVICE_URL=https://hcl-uno-agentic-runner-test:8080
# The base URL of the Agentic AI Context Manager (CM) service.
UNO_AGENTIC_AI_CM_SERVICE_URL=https://hcl-uno-agentic-cm:8000
# The WebSocket URL of the Agentic AI production runner for real-time communication.
UNO_AGENTIC_AI_RUNNER_PROD_WSS_URL=wss://hcl-uno-agentic-runner-prod:8080
# The WebSocket URL of the Agentic AI test runner for real-time communication.
UNO_AGENTIC_AI_RUNNER_TEST_WSS_URL=wss://hcl-uno-agentic-runner-test:8080
# The executor name registered for the Agentic AI test runner instance.
UNO_AGENTIC_AI_RUNNER_TEST_EXECUTOR_NAME=runner-test
# The key prefix used to namespace Agentic AI test runner resources (e.g., in Valkey).
UNO_AGENTIC_AI_RUNNER_TEST_EXECUTOR_PREFIX_KEY=test
# The executor name registered for the Agentic AI production runner instance.
UNO_AGENTIC_AI_RUNNER_PROD_EXECUTOR_NAME=runner-prod
# The key prefix used to namespace Agentic AI production runner resources (e.g., in Valkey).
UNO_AGENTIC_AI_RUNNER_PROD_EXECUTOR_PREFIX_KEY=prod
# The location of the Agentic AI Builder public key certificate used to verify JWT tokens.
EXTERNAL_MP_JWT__AGENTIC_AI_BUILDER_SYSTEM__VERIFY_PUBLICKEY_LOCATION=/security/agenticbuilder/jwt/jwt.crt

# The PostgreSQL user for the Agentic AI Builder service.
UNO_AGENTICBUILDER_PGUSER=agentic
# The PostgreSQL database name for the Agentic AI Builder service.
UNO_AGENTICBUILDER_DB=agentic

# --- ON-PREMISE PARITY & TUNING ---
# JVM heap size settings for UnO microservices.
JAVA_MEM="-Xms1024m -Xmx1024m"
# The amount of time on or after which connection to the OIDC provider goes in timeout (ISO 8601 format).
QUARKUS_OIDC_CONNECTION_TIMEOUT=PT1M
# This specifies the log/trace detail level for HCL components. Supported values are ALL, FINE, INFO.
QUARKUS_LOG_CATEGORY__COM_HCL__LEVEL=DEBUG

# The public URL(Load balanced url or DNS) where the UnO console is externally reachable.
UNO_PUBLIC_URL=https://localhost:8443
